# Set your LLM provider (openai, ollama, gemini)
LLM_PROVIDER=ollama
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=models/gemini-2.5-flash

# Embeddings always run locally with Hugging Face; no API key is used.
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Required only if OpenAI is selected as the LLM or vision provider.
OPENAI_API_KEY=your_openai_api_key_here

# Required only if Gemini is selected as the LLM or vision provider.
GOOGLE_API_KEY=your_google_api_key_here
